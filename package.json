{
  "name": "neto-autonomo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^24.22.1"
  },
  "scripts": {
    "predev": "node scripts/check-node-version.mjs",
    "dev": "node ./node_modules/next/dist/bin/next dev -p 3001",
    "prebuild": "node scripts/check-node-version.mjs",
    "build": "node ./node_modules/next/dist/bin/next build",
    "prestart": "node scripts/check-node-version.mjs",
    "start": "node ./node_modules/next/dist/bin/next start -p 3001",
    "lint": "node ./node_modules/eslint/bin/eslint.js .",
    "test": "node ./node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "overrides": {
    "postcss": "8.5.28",
    "@next/eslint-plugin-next@16.4.2": {
      "fast-glob": "$fast-glob"
    }
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "fast-glob": "file:./tooling/eslint-root-glob",
    "jsdom": "^26.1.0",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
